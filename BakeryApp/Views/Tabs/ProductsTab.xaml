<!-- Views/Tabs/ProductsTab.xaml -->
<UserControl x:Class="BakeryApp.Views.Tabs.ProductsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBgBrush}">
    <Grid Margin="4,8,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── ФОРМА ДОБАВЛЕНИЯ ──────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Добавить продукцию" Style="{StaticResource SectionTitle}"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"  MinWidth="120"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"  MinWidth="120"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="2*" MinWidth="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Название -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Название *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtProdName" Height="34"/>
                    </StackPanel>

                    <!-- Тип -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Тип *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbProdType" Height="34" IsEditable="True">
                            <ComboBoxItem>Хлеб</ComboBoxItem>
                            <ComboBoxItem>Булка</ComboBoxItem>
                            <ComboBoxItem>Пирожное</ComboBoxItem>
                            <ComboBoxItem>Пирог</ComboBoxItem>
                            <ComboBoxItem>Печенье</ComboBoxItem>
                            <ComboBoxItem>Батон</ComboBoxItem>
                            <ComboBoxItem>Торт</ComboBoxItem>
                            <ComboBoxItem>Прочее</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Цена продажи -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Цена продажи ₽ *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtProdPrice" Height="34" Text="0"/>
                    </StackPanel>

                    <!-- Заметки -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Заметки" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtProdNotes" Height="34"
                                 ToolTip="Например: вес 0.5 кг, с маком, без сахара"/>
                    </StackPanel>

                    <!-- Кнопка -->
                    <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                        <Button Content="+ Добавить"
                                Style="{StaticResource PrimaryButton}"
                                Height="34" MinWidth="120"
                                Click="BtnAdd_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── ПОИСК ─────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Поиск:" FontSize="16" VerticalAlignment="Center"
                           Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="1" x:Name="txtSearch" Height="32"
                         TextChanged="TxtSearch_TextChanged"
                         ToolTip="Поиск по названию, типу, заметкам"/>
                <TextBlock Grid.Column="2" x:Name="lblCount"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- ── ТАБЛИЦА ───────────────────────────────────────── -->
        <DataGrid Grid.Row="2" x:Name="dgProducts"
                  Margin="0,0,0,8"
                  SelectionChanged="DgProducts_SelectionChanged">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"         Color="{StaticResource SelectionColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3D2060"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"     Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#"           Binding="{Binding Id}"        Width="50"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Название"    Binding="{Binding Name}"      Width="*"   IsReadOnly="True"/>
                <DataGridTextColumn Header="Тип"         Binding="{Binding Type}"      Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Цена прод. ₽" Binding="{Binding SalePrice, StringFormat='{}{0:N2}'}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Заметки"     Binding="{Binding Notes}"     Width="2*"  IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── КНОПКИ ДЕЙСТВИЙ ──────────────────────────────── -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Редактировать"
                        Style="{StaticResource NeutralButton}"
                        x:Name="btnEdit" IsEnabled="False" Height="36"
                        Click="BtnEdit_Click" Margin="0,0,8,0"/>
                <Button Content="Удалить"
                        Style="{StaticResource DangerButton}"
                        x:Name="btnDelete" IsEnabled="False" Height="36"
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
