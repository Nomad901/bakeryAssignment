<!-- Views/Tabs/SalesTab.xaml -->
<UserControl x:Class="BakeryApp.Views.Tabs.SalesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBgBrush}">
    <Grid Margin="4,8,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── ФОРМА ДОБАВЛЕНИЯ ──────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Добавить запись о продаже" Style="{StaticResource SectionTitle}"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="2*" MinWidth="140"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"  MinWidth="90"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"  MinWidth="100"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"  MinWidth="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"  MinWidth="130"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Дата -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Дата *" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="dpSaleDate" Height="34" SelectedDateFormat="Short"/>
                    </StackPanel>

                    <!-- Продукт -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Продукция *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbSaleProduct" Height="34" IsEditable="True"/>
                    </StackPanel>

                    <!-- Количество -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Кол-во *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtSaleQty" Height="34" Text="1"
                                 TextChanged="CalcTotal_TextChanged"/>
                    </StackPanel>

                    <!-- Цена за ед. -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Цена за ед. ₽ *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtSalePrice" Height="34" Text="0"
                                 TextChanged="CalcTotal_TextChanged"/>
                    </StackPanel>

                    <!-- Итого (авто) -->
                    <StackPanel Grid.Column="8">
                        <TextBlock Text="Итого ₽" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtSaleTotal" Height="34" Text="0"
                                 Background="#1A1A30" IsReadOnly="True"
                                 Foreground="{StaticResource AccentBrush}"
                                 FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Покупатель -->
                    <StackPanel Grid.Column="10">
                        <TextBlock Text="Покупатель / точка сбыта" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtSaleBuyer" Height="34"
                                 ToolTip="Необязательное поле"/>
                    </StackPanel>

                    <!-- Кнопка -->
                    <StackPanel Grid.Column="12" VerticalAlignment="Bottom">
                        <Button Content="+ Добавить"
                                Style="{StaticResource PrimaryButton}"
                                Height="34" MinWidth="110"
                                Click="BtnAdd_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── ФИЛЬТР ПО ДАТЕ + ПОИСК ───────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Период:" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                <DatePicker Grid.Column="2"  x:Name="dpSaleFrom" Height="32"
                            SelectedDateFormat="Short" ToolTip="Дата с"/>
                <TextBlock  Grid.Column="4"  Text="—" VerticalAlignment="Center"
                            Foreground="{StaticResource TextSecondaryBrush}"/>
                <DatePicker Grid.Column="6"  x:Name="dpSaleTo" Height="32"
                            SelectedDateFormat="Short" ToolTip="Дата по"/>
                <Button     Grid.Column="8"  Content="Применить"
                            Style="{StaticResource PrimaryButton}" Height="32"
                            Click="BtnFilter_Click"/>
                <Button     Grid.Column="10" Content="Сбросить"
                            Style="{StaticResource NeutralButton}" Height="32"
                            Click="BtnReset_Click"/>

                <TextBlock  Grid.Column="11" Text="Поиск:" FontSize="16" VerticalAlignment="Center"
                            Margin="16,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox    Grid.Column="12" x:Name="txtSaleSearch" Height="32"
                            TextChanged="TxtSearch_TextChanged"
                            ToolTip="Поиск по продукции или покупателю"/>
                <TextBlock  Grid.Column="13" x:Name="lblSaleCount"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- ── ТАБЛИЦА ───────────────────────────────────────── -->
        <DataGrid Grid.Row="2" x:Name="dgSales"
                  Margin="0,0,0,8"
                  SelectionChanged="DgSales_SelectionChanged">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"         Color="{StaticResource SelectionColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3D2060"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"     Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#"               Binding="{Binding Id}"          Width="50"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Дата"            Binding="{Binding RecordDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Продукция"       Binding="{Binding ProductName}" Width="*"   IsReadOnly="True"/>
                <DataGridTextColumn Header="Кол-во"          Binding="{Binding Quantity, StringFormat='{}{0:N3}'}"    Width="90"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Цена ед. ₽"      Binding="{Binding UnitPrice, StringFormat='{}{0:N2}'}"  Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Итого ₽"         Binding="{Binding TotalAmount, StringFormat='{}{0:N2}'}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Покупатель"      Binding="{Binding Buyer}"       Width="*"   IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── КНОПКИ ДЕЙСТВИЙ ──────────────────────────────── -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Редактировать"
                            Style="{StaticResource NeutralButton}"
                            x:Name="btnEdit" IsEnabled="False" Height="36"
                            Click="BtnEdit_Click" Margin="0,0,8,0"/>
                    <Button Content="Удалить"
                            Style="{StaticResource DangerButton}"
                            x:Name="btnDelete" IsEnabled="False" Height="36"
                            Click="BtnDelete_Click"/>
                </StackPanel>

                <!-- Итоговая сумма по фильтру -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Итого по фильтру: "
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblTotal"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
