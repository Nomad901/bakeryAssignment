<!-- Views/Tabs/ProductionTab.xaml -->
<UserControl x:Class="BakeryApp.Views.Tabs.ProductionTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBgBrush}">
    <Grid Margin="4,8,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Форма добавления -->
            <RowDefinition Height="Auto"/>  <!-- Фильтр по дате -->
            <RowDefinition Height="*"/>     <!-- Таблица -->
            <RowDefinition Height="Auto"/>  <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- ── ФОРМА ДОБАВЛЕНИЯ ──────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Добавить запись о выпуске" Style="{StaticResource SectionTitle}"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="2*" MinWidth="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"  MinWidth="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="2*" MinWidth="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Дата -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Дата *" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="dpPrDate" Height="34"
                                    SelectedDateFormat="Short"/>
                    </StackPanel>

                    <!-- Продукт -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Продукция *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbPrProduct" Height="34" IsEditable="True"
                                  ToolTip="Выберите из справочника или введите вручную"/>
                    </StackPanel>

                    <!-- Количество -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Кол-во (шт/кг) *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtPrQty" Height="34" Text="1"/>
                    </StackPanel>

                    <!-- Комментарий -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Комментарий" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtPrComment" Height="34"
                                 ToolTip="Например: смена №1, Иванов"/>
                    </StackPanel>

                    <!-- Кнопка -->
                    <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                        <Button Content="+ Добавить"
                                Style="{StaticResource PrimaryButton}"
                                Height="34" MinWidth="120"
                                Click="BtnAdd_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── ФИЛЬТР ПО ДАТЕ + ПОИСК ───────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Период:" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                <DatePicker Grid.Column="2"  x:Name="dpPrFrom" Height="32"
                            SelectedDateFormat="Short" ToolTip="Дата с"/>
                <TextBlock  Grid.Column="4"  Text="—" VerticalAlignment="Center"
                            Foreground="{StaticResource TextSecondaryBrush}"/>
                <DatePicker Grid.Column="6"  x:Name="dpPrTo" Height="32"
                            SelectedDateFormat="Short" ToolTip="Дата по"/>
                <Button     Grid.Column="8"  Content="Применить"
                            Style="{StaticResource PrimaryButton}" Height="32"
                            Click="BtnFilter_Click"/>
                <Button     Grid.Column="10" Content="Сбросить"
                            Style="{StaticResource NeutralButton}" Height="32"
                            Click="BtnReset_Click"/>

                <TextBlock  Grid.Column="11" Text="Поиск:" FontSize="16" VerticalAlignment="Center"
                            Margin="16,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox    Grid.Column="12" x:Name="txtPrSearch" Height="32"
                            TextChanged="TxtSearch_TextChanged"
                            ToolTip="Поиск по названию продукции или комментарию"/>
                <TextBlock  Grid.Column="13" x:Name="lblPrCount"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- ── ТАБЛИЦА ───────────────────────────────────────── -->
        <DataGrid Grid.Row="2" x:Name="dgProduction"
                  Margin="0,0,0,8"
                  SelectionChanged="DgProduction_SelectionChanged">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"         Color="{StaticResource SelectionColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3D2060"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"     Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#"           Binding="{Binding Id}"          Width="50"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Дата"        Binding="{Binding RecordDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Продукция"   Binding="{Binding ProductName}" Width="*"   IsReadOnly="True"/>
                <DataGridTextColumn Header="Количество"  Binding="{Binding Quantity, StringFormat='{}{0:N3}'}"           Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}"     Width="2*"  IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── КНОПКИ ДЕЙСТВИЙ ──────────────────────────────── -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Редактировать"
                        Style="{StaticResource NeutralButton}"
                        x:Name="btnEdit" IsEnabled="False" Height="36"
                        Click="BtnEdit_Click" Margin="0,0,8,0"/>
                <Button Content="Удалить"
                        Style="{StaticResource DangerButton}"
                        x:Name="btnDelete" IsEnabled="False" Height="36"
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
