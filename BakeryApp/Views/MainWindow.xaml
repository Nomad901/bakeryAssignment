<!-- Views/MainWindow.xaml -->
<Window x:Class="BakeryApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:BakeryApp.Views.Tabs"
        Title="Пекарня — учётная система"
        Height="780" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>   <!-- Шапка -->
            <RowDefinition Height="*"/>    <!-- Контент -->
        </Grid.RowDefinitions>

        <!-- ── ШАПКА ─────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип / название -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="" FontSize="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ПЕКАРНЯ"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Система учёта"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Версия -->
                <TextBlock Grid.Column="2"
                           Text="v1.0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── ВКЛАДКИ ───────────────────────────────────────────── -->
        <TabControl Grid.Row="1"
                    x:Name="MainTabControl"
                    Margin="16,8,16,16">

            <!-- Вкладка 1: Ингредиенты -->
            <TabItem Header="Ингредиенты">
                <tabs:IngredientsTab x:Name="IngrTab"/>
            </TabItem>

            <!-- Вкладка 2: Продукция -->
            <TabItem Header="Продукция">
                <tabs:ProductsTab x:Name="ProdTab"/>
            </TabItem>

            <!-- Вкладка 3: Производство -->
            <TabItem Header="Производство">
                <tabs:ProductionTab x:Name="PrTab"/>
            </TabItem>

            <!-- 
            <TabItem Header="Продажи">
                <tabs:SalesTab x:Name="SaleTab"/>
            </TabItem>
-->
            
        </TabControl>
    </Grid>
</Window>
