<!-- Views/Dialogs/QuickQuantityDialog.xaml -->
<Window x:Class="BakeryApp.Views.Dialogs.QuickQuantityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменить количество"
        Height="220" Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" x:Name="lblTitle"
                   FontSize="16" FontWeight="Bold"
                   Foreground="White"/>

        <!-- Подсказка -->
        <TextBlock Grid.Row="2" x:Name="lblPrompt"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="13" TextWrapping="Wrap"/>

        <!-- Поле ввода -->
        <StackPanel Grid.Row="4">
            <TextBlock x:Name="lblUnit"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtValue"
                     Height="38" FontSize="15"
                     KeyDown="TxtValue_KeyDown"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Style="{StaticResource NeutralButton}"
                    Height="36" MinWidth="90"
                    Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnOk" Content="Подтвердить"
                    Style="{StaticResource PrimaryButton}"
                    Height="36" MinWidth="130"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
