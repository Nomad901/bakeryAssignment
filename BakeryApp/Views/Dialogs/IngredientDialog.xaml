<!-- Views/Dialogs/IngredientDialog.xaml -->
<Window x:Class="BakeryApp.Views.Dialogs.IngredientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать ингредиент"
        Height="340" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Редактировать ингредиент"
                   Style="{StaticResource SectionTitle}"/>

        <!-- Название -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Название *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtName" Height="36"/>
        </StackPanel>

        <!-- Единица измерения -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Единица измерения *" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="cmbUnit" IsEditable="True" Height="36">
                <ComboBoxItem>кг</ComboBoxItem>
                <ComboBoxItem>г</ComboBoxItem>
                <ComboBoxItem>л</ComboBoxItem>
                <ComboBoxItem>мл</ComboBoxItem>
                <ComboBoxItem>шт</ComboBoxItem>
                <ComboBoxItem>упак</ComboBoxItem>
                <ComboBoxItem>мешок</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!-- Количество и цена -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Количество *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtQty" Height="36"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Закупочная цена (₽) *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtPrice" Height="36"/>
            </StackPanel>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Style="{StaticResource NeutralButton}"
                    Height="36" MinWidth="90"
                    Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <Button Content="Сохранить"
                    Style="{StaticResource PrimaryButton}"
                    Height="36" MinWidth="120"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
