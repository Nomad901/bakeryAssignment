<!-- Views/Dialogs/ProductDialog.xaml -->
<Window x:Class="BakeryApp.Views.Dialogs.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать продукцию"
        Height="360" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Редактировать продукцию"
                   Style="{StaticResource SectionTitle}"/>

        <!-- Название -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Название *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtName" Height="36"/>
        </StackPanel>

        <!-- Тип -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Тип *" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="cmbType" IsEditable="True" Height="36">
                <ComboBoxItem>Хлеб</ComboBoxItem>
                <ComboBoxItem>Булка</ComboBoxItem>
                <ComboBoxItem>Пирожное</ComboBoxItem>
                <ComboBoxItem>Пирог</ComboBoxItem>
                <ComboBoxItem>Печенье</ComboBoxItem>
                <ComboBoxItem>Батон</ComboBoxItem>
                <ComboBoxItem>Торт</ComboBoxItem>
                <ComboBoxItem>Прочее</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!-- Цена -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="Цена продажи (₽) *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtPrice" Height="36"/>
        </StackPanel>

        <!-- Заметки -->
        <StackPanel Grid.Row="8">
            <TextBlock Text="Заметки" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtNotes" Height="36"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Style="{StaticResource NeutralButton}"
                    Height="36" MinWidth="90"
                    Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <Button Content="Сохранить"
                    Style="{StaticResource PrimaryButton}"
                    Height="36" MinWidth="120"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
